# Caddy tự lấy và gia hạn chứng chỉ HTTPS cho DOMAIN (đặt trong .env)
{$DOMAIN} {
	encode zstd gzip

	# API và ảnh upload -> back-end Spring Boot
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /uploads/* {
		reverse_proxy backend:8080
	}

	# Còn lại là front-end Vue (history mode: đường dẫn lạ trả về index.html)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# File trong /assets có hash trong tên nên cache lâu được
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# www.domain -> domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
