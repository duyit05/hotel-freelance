# Copy thành /opt/hotel/.env trên VPS rồi sửa TẤT CẢ giá trị bên dưới.
# Tạo chuỗi ngẫu nhiên:  openssl rand -base64 48

# Tên miền (không có https://, không có www). DNS bản ghi A của domain và www phải trỏ về IP VPS.
DOMAIN=example.com

# PostgreSQL
DB_USERNAME=hotel
DB_PASSWORD=doi-mat-khau-db

# JWT: chuỗi ngẫu nhiên, ít nhất 32 ký tự
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Tài khoản admin tạo ở lần chạy đầu tiên (đổi mật khẩu ngay sau khi đăng nhập nếu có chức năng)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin
ADMIN_FULL_NAME="Quản trị viên"
