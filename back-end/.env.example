# Biến môi trường cho back-end (copy thành .env rồi sửa giá trị)
# Spring Boot đọc qua spring.config.import, docker compose tự đọc khi chạy "docker compose up -d"

# ===== PostgreSQL =====
DB_URL=jdbc:postgresql://localhost:5433/hotel
DB_USERNAME=hotel
DB_PASSWORD=hotel

# ===== JWT (chuỗi ngẫu nhiên, ít nhất 32 ký tự) =====
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# ===== Tài khoản admin tạo lần đầu =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Quản trị viên

# ===== Khác =====
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
