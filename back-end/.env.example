# Biến môi trường cho back-end (copy thành .env rồi sửa giá trị)
# Spring Boot đọc qua spring.config.import. Postgres bằng Docker cho dev: xem deploy/dev/compose.yaml

# ===== PostgreSQL =====
DB_URL=jdbc:postgresql://localhost:5433/hotel
DB_USERNAME=hotel
DB_PASSWORD=hotel

# ===== JWT (chuỗi ngẫu nhiên, ít nhất 32 ký tự) =====
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Cookie refresh token chỉ gửi qua HTTPS (vẫn chạy được trên http://localhost).
# Chỉ đặt false khi chạy thử qua HTTP bằng IP/tên miền khác localhost
# JWT_COOKIE_SECURE=true

# ===== Tài khoản admin tạo lần đầu =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Quản trị viên

# ===== Lưu ảnh =====
# local (mặc định): lưu ảnh vào thư mục UPLOAD_DIR
STORAGE_TYPE=local
UPLOAD_DIR=uploads
# Chỉ cần khi STORAGE_TYPE=minio (lưu trên MinIO/S3)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=hotel-images

# ===== Khác =====
CORS_ORIGINS=http://localhost:5173
